---
import Layout from "../layouts/Layout.astro";

// One option every 5 years from 1950 to 2025, plus today (2026) as the
// punchline. 1970 is grounded, not invented: a standing-room ticket to the
// VFL Grand Final was 80c that year, close enough to $1 that the machine
// can plausibly dispense it whole with change. The rest are honest,
// unsourced comedic beats tracking the same decline — the machine's whole
// argument is that the dollar buys steadily less, and today's is the joke.
const YEARS = [
  { year: 1950, result: "a week's newspapers and a tram fare home, with change left over" },
  { year: 1955, result: "a return tram fare and a bag of lollies" },
  { year: 1960, result: "a movie ticket, a choc-top, and the bus fare home" },
  { year: 1965, result: "a loaf of bread, a pint of milk, and a newspaper" },
  {
    year: 1970,
    result: "a standing-room ticket to the Grand Final, and 20c left over",
  },
  { year: 1975, result: "a schooner at the pub and a packet of chips" },
  { year: 1980, result: "a movie ticket, no choc-top this time" },
  { year: 1985, result: "a sandwich and a can of drink" },
  { year: 1990, result: "a loaf of bread and a stamp" },
  {
    year: 1995,
    result: "a can of soft drink from the machine next door",
  },
  { year: 2000, result: "a one-zone bus ticket" },
  { year: 2005, result: "a small coffee, if you skip the tip jar" },
  { year: 2010, result: "half a coffee, the small one" },
  { year: 2015, result: "a packet of chewing gum" },
  { year: 2020, result: "a single lolly from the servo counter" },
  { year: 2025, result: "the smell of a bakery, nothing to take home" },
  {
    year: 2026,
    result: "nothing — the machine keeps your dollar and jams",
  },
];

// Tick marks for the semicircle gauge: one per year, swept evenly from 180°
// (left, earliest year) to 0° (right, latest year) across the top half of
// the dial. The needle uses the same angle-per-step math at runtime.
const GAUGE_CENTER = 100;
const GAUGE_CY = 100;
const TICK_INNER = 74;
const TICK_OUTER = 90;
const ANGLE_STEP = 180 / (YEARS.length - 1);
const ticks = YEARS.map((_, i) => {
  const angleRad = ((180 - i * ANGLE_STEP) * Math.PI) / 180;
  return {
    x1: GAUGE_CENTER + TICK_INNER * Math.cos(angleRad),
    y1: GAUGE_CY - TICK_INNER * Math.sin(angleRad),
    x2: GAUGE_CENTER + TICK_OUTER * Math.cos(angleRad),
    y2: GAUGE_CY - TICK_OUTER * Math.sin(angleRad),
  };
});
---

<Layout title="The $1 Machine">
  <header>
    <nav aria-label="Primary">
      <a href="./">Home</a>
    </nav>
  </header>
  <main>
    <h1>The $1 Machine</h1>
    <p>
      Same coin, same lever, every time. Set the year, pull the lever, and see
      what your dollar is actually worth.
    </p>

    <div class="machine" id="machine">
      <p class="machine-marquee" aria-hidden="true">$1 ONLY</p>

      <div class="machine-face">
        <select
          id="year-dial"
          data-testid="year-dial"
          class="sr-only"
          aria-hidden="true"
          tabindex="-1"
        >
          {
            YEARS.map(({ year, result }) => (
              <option value={year} data-result={result}>
                {year}
              </option>
            ))
          }
        </select>

        <div class="machine-control machine-window year-gauge" aria-label="Set the year">
          <svg class="gauge-arc" viewBox="0 0 200 110" aria-hidden="true" focusable="false">
            <path class="gauge-track" d="M10,100 A90,90 0 0 1 190,100" />
            {
              ticks.map((t) => (
                <line class="gauge-tick" x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} />
              ))
            }
            <line id="gauge-needle" class="gauge-needle" x1="100" y1="100" x2="100" y2="18" />
            <circle class="gauge-pivot" cx="100" cy="100" r="5" />
          </svg>

          <div class="gauge-row">
            <button
              type="button"
              id="year-prev"
              class="gauge-step"
              aria-label="Previous year"
              disabled
            >
              ‹
            </button>
            <output id="gauge-year" class="gauge-year" aria-live="polite">
              {YEARS[0].year}
            </output>
            <button type="button" id="year-next" class="gauge-step" aria-label="Next year">
              ›
            </button>
          </div>

          <button type="button" id="year-random" class="dice-button" aria-label="Random year">
            <span aria-hidden="true">🎲</span>
          </button>
        </div>
      </div>

      <div class="coin-slot" aria-hidden="true"></div>

      <button type="button" id="coin" class="machine-coin">
        <span class="sr-only">Insert coin</span>
        <span aria-hidden="true">$1</span>
      </button>

      <button id="lever" data-testid="core-interaction-trigger" class="machine-lever">
        <span class="sr-only">Pull the lever</span>
        <svg class="lever-svg" viewBox="0 0 120 60" aria-hidden="true" focusable="false">
          <rect class="lever-bracket" x="4" y="8" width="20" height="44" rx="6" />
          <g class="lever-rod">
            <rect x="18" y="26" width="64" height="8" rx="4" />
            <circle class="lever-knob" cx="88" cy="30" r="15" />
          </g>
        </svg>
      </button>

      <p id="lever-hint" class="lever-hint" role="status" aria-live="polite"></p>

      <div class="machine-tray">
        <output id="tray-result" data-testid="core-interaction-result" class="machine-result">
          Insert a coin, set the year, then pull the lever.
        </output>
      </div>
    </div>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>

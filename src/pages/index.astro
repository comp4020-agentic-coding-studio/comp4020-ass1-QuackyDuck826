---
import Layout from "../layouts/Layout.astro";

// Every 3 years from 1966 to 2026 — 21 entries, evenly spaced. 1966 is
// Decimal Currency Day (14 February 1966), when Australia's pounds,
// shillings, and pence became dollars and cents overnight (see the placard),
// so it's the machine's true starting point, not a round number picked for
// convenience. The results are pegged to real prices where a solid source
// exists rather than invented figures:
//   - 1972: McDonald's didn't open in Australia until Dec 1971; a Big Mac at
//     the brand-new Sydney store was 49c in 1972, hence "51c left over".
//   - 1993's "about 30c back" for a chocolate bar is the one estimate in this
//     list without a hard source behind it — no year-by-year Australian
//     chocolate-bar price record turned up, so it's a plausible guess, not a
//     citation, unlike the Big Mac and postage figures below.
//   - The basic postage stamp is the one price with a clean, continuous,
//     citable record across the whole range (Australia Post / Wikipedia's
//     "List of postage rates in Australia"): 4c in 1966, rising to $1.00 by
//     2017 and $1.10 by 2020 — i.e. the exact year a stamp alone cost more
//     than the dollar coin buying it. That crossover is used as-is below.
//   - Milk is "a pint" only up to 1969: the metric conversion of everyday
//     goods (pints to litres) landed in the early-to-mid 1970s, so 1972
//     onward uses "a litre".
// Cinema, bus-fare, and café-coffee prices don't have a clean year-by-year
// AUD record, so those years lean on generic, non-numeric items (a chocolate
// bar, a can of drink, a bag of lollies) rather than a specific invented
// price. The two coffee entries (2005, 2008) are the exception — café coffee
// was already a mainstream, price-comparable good nationally by then.
const YEARS = [
  {
    year: 1966,
    result: "a loaf of bread, a pint of milk, and enough new decimal coins left over to jingle",
  },
  { year: 1969, result: "a pint of milk, the evening paper, and a bag of mixed lollies" },
  {
    year: 1972,
    result: "a Big Mac from Australia's brand-new McDonald's, with 51c left over",
  },
  { year: 1975, result: "a litre of milk, a loaf of bread, and a stamp to post the bill" },
  { year: 1978, result: "a block of chocolate and a packet of chewing gum" },
  { year: 1981, result: "a block of chocolate, and that's your lot" },
  { year: 1984, result: "a sandwich and a can of drink" },
  { year: 1987, result: "a loaf of bread and a stamp" },
  {
    year: 1990,
    result: "a can of soft drink from the machine next door",
  },
  { year: 1993, result: "a chocolate bar, with about 30c back" },
  { year: 1996, result: "a bag of mixed lollies" },
  { year: 1999, result: "a packet of chewing gum" },
  { year: 2002, result: "a stamp and a couple of lollies" },
  { year: 2005, result: "a small coffee, if you skip the tip jar" },
  { year: 2008, result: "half a coffee, the small one" },
  { year: 2011, result: "a stick of chewing gum" },
  { year: 2014, result: "a single lolly from the servo counter" },
  { year: 2017, result: "a single stamp — the whole dollar, gone on postage" },
  {
    year: 2020,
    result: "not even a stamp — postage passed a dollar first",
  },
  { year: 2023, result: "the smell of a bakery, nothing to take home" },
  {
    year: 2026,
    result: "nothing — the machine keeps your dollar and jams",
  },
];

// Tick marks for the semicircle gauge: one per year, swept evenly from 180°
// (left, earliest year) to 0° (right, latest year) across the top half of
// the dial. The needle uses the same angle-per-step math at runtime. Every
// quarter-step (start, quarters, midpoint, end) gets a longer, bolder major
// tick so the dial reads at a glance; the rest stay short minor ticks.
const GAUGE_CENTER = 100;
const GAUGE_CY = 100;
const TICK_OUTER = 90;
const TICK_INNER_MINOR = 81;
const TICK_INNER_MAJOR = 62;
const ANGLE_STEP = 180 / (YEARS.length - 1);
const QUARTER_STEP = (YEARS.length - 1) / 4;
const ticks = YEARS.map((_, i) => {
  const isMajor = i % QUARTER_STEP === 0;
  const tickInner = isMajor ? TICK_INNER_MAJOR : TICK_INNER_MINOR;
  const angleRad = ((180 - i * ANGLE_STEP) * Math.PI) / 180;
  return {
    isMajor,
    x1: GAUGE_CENTER + tickInner * Math.cos(angleRad),
    y1: GAUGE_CY - tickInner * Math.sin(angleRad),
    x2: GAUGE_CENTER + TICK_OUTER * Math.cos(angleRad),
    y2: GAUGE_CY - TICK_OUTER * Math.sin(angleRad),
  };
});

// Decorative gears poking out from either side of the cabinet, as if
// they're driving some internal mechanism — three on the left, two on the
// right, in three different sizes, some tucked behind the cabinet face and
// some sitting in front of it. Each tooth is a rect swept evenly around the
// body — same rotate-and-place approach as the ticks above. Position/size
// per cog is set in CSS via the side/index/size classes below.
const COG_TEETH = 8;
const COG_CENTER = 30;
const cogToothAngles = Array.from({ length: COG_TEETH }, (_, i) => (360 / COG_TEETH) * i);
const COGS = [
  { side: "left", index: 1, size: "lg" },
  { side: "left", index: 2, size: "md" },
  { side: "left", index: 3, size: "sm" },
  { side: "right", index: 1, size: "md" },
  { side: "right", index: 2, size: "sm" },
];
---

<Layout title="The $1 Machine">
  <header>
    <nav aria-label="Primary">
      <a href="#machine">The machine</a>
      <a href="#collected">My collection</a>
    </nav>
  </header>
  <main>
    <div class="placard">
      <h1>The $1 Machine</h1>
      <p>
        Same coin, same lever, every time. Set the year, pull the lever, and
        see what your dollar is actually worth.
      </p>
      <p class="placard-history">
        Australia didn't have dollars until 14 February 1966 — "C-Day" —
        when pounds, shillings, and pence were retired overnight for dollars
        and cents (the changeover was drilled into the public with a jingle,
        <em>Dollar Bill</em>, set to the tune of <em>Click Go the Shears</em>).
        That's this machine's starting year: everything on the dial tracks
        the same dollar's buying power from the day it was born to today.
      </p>
    </div>

    <div class="machine" id="machine">
      <p class="machine-marquee" aria-hidden="true">$1 ONLY</p>

      {
        COGS.map((cog) => (
          <svg
            class={`machine-cog machine-cog-${cog.side} machine-cog-${cog.side}-${cog.index} machine-cog-${cog.size}`}
            viewBox="0 0 60 60"
            aria-hidden="true"
            focusable="false"
          >
            <g class="cog-spin">
              <g class="cog-outline">
                <circle cx="30" cy="30" r="18" />
                {
                  cogToothAngles.map((deg) => (
                    <rect
                      x="26"
                      y="4"
                      width="8"
                      height="10"
                      rx="1.5"
                      transform={`rotate(${deg} ${COG_CENTER} ${COG_CENTER})`}
                    />
                  ))
                }
              </g>
              <g class="cog-fill">
                <circle cx="30" cy="30" r="18" />
                {
                  cogToothAngles.map((deg) => (
                    <rect
                      x="26"
                      y="4"
                      width="8"
                      height="10"
                      rx="1.5"
                      transform={`rotate(${deg} ${COG_CENTER} ${COG_CENTER})`}
                    />
                  ))
                }
              </g>
              <circle class="cog-hole" cx="30" cy="30" r="6" />
            </g>
          </svg>
        ))
      }

      <div class="machine-face">
        <select
          id="year-dial"
          data-testid="year-dial"
          class="sr-only"
          aria-hidden="true"
          tabindex="-1"
        >
          {
            YEARS.map(({ year, result }) => (
              <option value={year} data-result={result}>
                {year}
              </option>
            ))
          }
        </select>

        <div class="machine-control machine-window year-gauge" aria-label="Set the year">
          <svg class="gauge-arc" viewBox="0 0 200 110" aria-hidden="true" focusable="false">
            <path class="gauge-fill" d="M64,100 A36,36 0 0 1 136,100 Z" />
            <path class="gauge-track" d="M10,100 A90,90 0 0 1 190,100" />
            {
              ticks.map((t) => (
                <line
                  class={`gauge-tick ${t.isMajor ? "gauge-tick-major" : ""}`}
                  x1={t.x1}
                  y1={t.y1}
                  x2={t.x2}
                  y2={t.y2}
                />
              ))
            }
            <line id="gauge-needle" class="gauge-needle" x1="100" y1="100" x2="100" y2="18" />
            <circle class="gauge-pivot" cx="100" cy="100" r="5" />
          </svg>

          <div class="gauge-row">
            <button
              type="button"
              id="year-prev"
              class="gauge-step"
              aria-label="Previous year"
              disabled
            >
              ‹
            </button>
            <output id="gauge-year" class="gauge-year" aria-live="polite">
              {YEARS[0].year}
            </output>
            <button type="button" id="year-next" class="gauge-step" aria-label="Next year">
              ›
            </button>
          </div>

          <button type="button" id="year-random" class="dice-button" aria-label="Random year">
            <span aria-hidden="true">🎲</span>
          </button>
        </div>
      </div>

      <div class="console">
        <div class="coin-stack">
          <div class="coin-slot" aria-hidden="true"></div>

          <button type="button" id="coin" class="machine-coin">
            <span class="sr-only">Insert coin</span>
            <span aria-hidden="true">$1</span>
          </button>
        </div>

        <div class="lever-wrap">
          <button id="lever" data-testid="core-interaction-trigger" class="machine-lever">
            <span class="sr-only">Pull the lever</span>
            <svg class="lever-svg" viewBox="0 0 120 60" aria-hidden="true" focusable="false">
              <defs>
                <linearGradient id="leverBracketGradient" x1="0" y1="0" x2="0" y2="1">
                  <stop class="stop-steel-hi" offset="0%" />
                  <stop class="stop-steel-lo" offset="100%" />
                </linearGradient>
                <linearGradient id="leverRodGradient" x1="0" y1="0" x2="0" y2="1">
                  <stop class="stop-brass-hi" offset="0%" />
                  <stop class="stop-brass-lo" offset="100%" />
                </linearGradient>
                <radialGradient id="leverKnobGradient" cx="35%" cy="30%" r="75%">
                  <stop class="stop-brass-hi" offset="0%" />
                  <stop class="stop-brass-mid" offset="55%" />
                  <stop class="stop-brass-lo" offset="100%" />
                </radialGradient>
              </defs>
              <rect class="lever-bracket" x="4" y="8" width="20" height="44" rx="6" />
              <g class="lever-rod">
                <rect x="18" y="26" width="64" height="8" rx="4" />
                <circle class="lever-knob" cx="88" cy="30" r="15" />
              </g>
            </svg>
          </button>

          <p id="lever-hint" class="lever-hint" role="status" aria-live="polite"></p>
        </div>
      </div>

      <div class="machine-tray">
        <output id="tray-result" data-testid="core-interaction-result" class="machine-result">
          Insert a coin, set the year, then pull the lever.
        </output>
      </div>
    </div>

    <div class="about">
      <h2 class="about-heading">Why a machine</h2>
      <p class="about-copy">
        Inflation is normally reported as a percentage, a number small enough
        to forget before the next headline. This machine swaps the statistic
        for a lever: same coin, same mechanism, every time — and the tray just
        gives you back less than it used to.
      </p>
      <p class="about-copy">
        Wind the dial far enough and the joke stops being a joke. The machine
        isn't broken; it's running the exact same trick it always has,
        sixty years running.
      </p>
    </div>

    <section class="collected" id="collected" aria-label="Your collected purchases">
      <h2 class="collected-heading">Your collected purchases</h2>
      <p class="collected-caption">
        Every year on the dial, filled in as you go — so you can see what
        you've tried and what you're still missing.
      </p>
      <div class="collected-scroll">
        <table class="collected-table" id="collected-table" hidden>
          <thead>
            <tr>
              <th scope="col">Year</th>
              <th scope="col">What $1 bought</th>
            </tr>
          </thead>
          <tbody id="collected-body"></tbody>
        </table>
      </div>
      <p class="collected-status" id="collected-status" role="status" aria-live="polite"></p>
    </section>

    <p class="back-to-top"><a class="back-to-top-link" href="#top">Back to top</a></p>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>
